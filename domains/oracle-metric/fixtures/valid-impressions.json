    "market": { "id": "m-om-1", "created_at": 1730000000000,
      "verification": { "class": "oracle-metric",
        "params": { "field": "data.impressions", "min": 10000, "observed_field": "data.measured_at" } } },
    "claim": { "ref": "https://metrics.example.com/t/abc", "actor": "agent-7" }
